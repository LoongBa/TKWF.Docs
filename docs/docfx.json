{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/src/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "_Framework/**/*.csproj",
            "_Domain.Api/**/*.csproj",
            "_Domain.ApiService/**/*.csproj",
            "_Domain.Infrastructure/**/*.csproj",
            "_Domain.SG/CodeGeneration.Abstractions/**/*.csproj"
          ],
          "src": "../src/TKW.Framework"
        }
      ],
      "dest": "api",
      "filter": "filter.yml"
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/**.md", "api/toc.yml"] },
      { "files": ["articles/**/*.md"], "src": ".", "dest": "." },
      { "files": ["toc.yml"], "src": ".", "dest": "." },
      { "files": ["index.md"], "src": ".", "dest": "." }
    ],
    "resource": [
      { "files": ["404.md", "robots.txt", "llms.txt", "**/*.png", "**/*.jpg", "**/*.svg", "**/*.gif"], "exclude": ["_site/**", "_site_local/**", "_site_local*/**"] }
    ],
    "overwrite": [],
    "sitemap": {
      "baseUrl": "https://tkwf.loongba.cn",
      "fileOptions": {
        "articles/**/*.md": { "priority": "0.5" },
        "index.md": { "priority": "1.0" }
      }
    },
    "xref": ["https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"],
    "markdownEngineProperties": {
      "alerts": {
        "AGENTIC": "tip",
        "VERSION": "important"
      }
    },
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "TKWF — 领域自治框架",
      "_appFooter": "<span>© LoongBa.cn 2026. Powered by DocFX</span>",
      "_enableSearch": true,
      "_disableNavbar": false,
      "_disableBreadcrumb": false,
      "_disableToc": false
    },
    "template": ["default", "modern", "../templates/custom"],
    "postProcess": []
  }
}
