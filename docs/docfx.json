{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/src/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/TKW.Framework/Domain/**/*.csproj",
            "src/TKW.Framework/Domain.Web/**/*.csproj",
            "src/TKW.Framework/Domain.Maui/**/*.csproj",
            "src/TKW.Framework/Domain.Blazor/**/*.csproj",
            "src/TKW.Framework/Domain.FreeSql/**/*.csproj",
            "src/TKW.Framework/Domain.ApiService.MinimalApi/**/*.csproj",
            "src/TKW.Framework/Domain.ApiService.HotChocolate/**/*.csproj",
            "src/TKW.Framework/Domain.ApiClient/**/*.csproj",
            "src/TKW.Framework/Domain.ApiClient.Rest/**/*.csproj",
            "src/TKW.Framework/Domain.ApiClient.GraphQL/**/*.csproj",
            "src/TKW.Framework/Core/**/*.csproj",
            "src/TKW.Framework/TKWF.Abstractions/**/*.csproj",
            "src/TKW.Framework/TKWF.CodeGeneration/**/*.csproj",
            "src/TKW.Framework/Cryptography/**/*.csproj"
          ],
          "src": "."
        }
      ],
      "dest": "api",
      "filter": "filter.yml",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/**.md", "api/toc.yml"] },
      { "files": ["articles/**/*.md"], "src": ".", "dest": "." },
      { "files": ["toc.yml"], "src": ".", "dest": "." },
      { "files": ["index.md"], "src": ".", "dest": "." }
    ],
    "resource": [
      { "files": ["404.md", "robots.txt", "llms.txt", "**/*.png", "**/*.jpg", "**/*.svg", "**/*.gif"] }
    ],
    "overwrite": [],
    "sitemap": {
      "baseUrl": "https://loongba.github.io/TKWF.Docs",
      "fileOptions": {
        "articles/**/*.md": { "priority": "0.5" },
        "index.md": { "priority": "1.0" }
      }
    },
    "xref": ["https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"],
    "markdownEngineProperties": {
      "alerts": [
        { "name": "AGENTIC", "type": "tip" },
        { "name": "VERSION", "type": "important" }
      ]
    },
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "TKWF — 领域自治框架",
      "_appFooter": "<span>© LoongBa.cn 2026. Powered by DocFX</span>",
      "_enableSearch": true,
      "_disableNavbar": false,
      "_disableBreadcrumb": false,
      "_disableToc": false
    },
    "template": ["default", "modern", "../templates/custom"],
    "postProcess": []
  }
}
