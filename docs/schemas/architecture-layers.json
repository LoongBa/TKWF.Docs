{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architecture Layers",
  "type": "object",
  "required": ["intro", "layers"],
  "properties": {
    "intro": { "type": "string" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["icon", "name", "description"],
        "properties": {
          "icon": { "type": "string", "enum": ["layers","shield","database","plug","settings","code-2","git-branch","workflow","monitor","puzzle"] },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "color": { "type": "string", "enum": ["blue","green","purple","orange","amber","red"] },
          "items": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "coreComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description", "tags"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "dataFlow": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}