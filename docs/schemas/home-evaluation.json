{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evaluation",
  "type": "object",
  "required": ["title","intro","frameworks","trendSignals","detailLink"],
  "properties": {
    "title": { "type": "string" },
    "intro": { "type": "string" },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name","score","maxScore","color"],
        "properties": {
          "name": { "type": "string" },
          "score": { "type": "integer" },
          "maxScore": { "type": "integer" },
          "color": { "type": "string", "enum": ["blue","green","purple","orange","amber","red"] },
          "isWinner": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "trendSignals": { "type": "array", "items": { "type": "string" } },
    "detailLink": {
      "type": "object",
      "required": ["label","href","type"],
      "properties": {
        "label": { "type": "string" },
        "href": { "type": "string" },
        "type": { "type": "string", "enum": ["spa","docfx","external"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
