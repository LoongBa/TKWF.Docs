{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hero",
  "type": "object",
  "required": ["badges","title","subtitle","tagline","ctas"],
  "properties": {
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label","value","color"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "color": { "type": "string", "enum": ["blue","green","purple","orange","amber","red"] }
        },
        "additionalProperties": false
      }
    },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "tagline": { "type": "string" },
    "ctas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label","href","variant","type"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": "string" },
          "variant": { "type": "string", "enum": ["primary","outline","ghost","link"] },
          "type": { "type": "string", "enum": ["spa","docfx","external"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
