{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Versions",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["version","date","description"],
    "properties": {
      "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "description": { "type": "string" }
    },
    "additionalProperties": false
  }
}
