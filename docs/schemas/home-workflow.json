{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow",
  "type": "object",
  "required": ["title","quote","quoteAuthor","intro","steps","outputs","summary","principle"],
  "properties": {
    "title": { "type": "string" },
    "quote": { "type": "string" },
    "quoteAuthor": { "type": "string" },
    "intro": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["icon","label","subtitle","color"],
        "properties": {
          "icon": { "type": "string", "enum": ["settings","file-code","puzzle","zap","bar-chart-3","link","book-open","bot","monitor","plug","shield","lock","database","user","arrow-right","arrow-down","github","external-link","check-circle-2","x-circle","calendar-days","clock","rocket","layers","code-2","git-branch","workflow","copy","check","download","package","lightbulb","alert-triangle","microscope","refresh-cw","menu","x","sun","moon"] },
          "label": { "type": "string" },
          "subtitle": { "type": "string" },
          "color": { "type": "string", "enum": ["blue","green","purple","orange","amber","red"] }
        },
        "additionalProperties": false
      }
    },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "collaborationStep": {
      "type": "object",
      "properties": {
        "icon": { "type": "string" },
        "label": { "type": "string" },
        "subtitle": { "type": "string" }
      },
      "additionalProperties": false
    },
    "summary": { "type": "string" },
    "principle": { "type": "string" },
    "codeExample": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "language": { "type": "string" },
        "code": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
