{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Navigation",
  "type": "object",
  "required": ["links","externalLinks"],
  "properties": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label","href","type"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": "string" },
          "type": { "type": "string", "enum": ["spa","docfx","external"] }
        },
        "additionalProperties": false
      }
    },
    "externalLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label","href","icon"],
        "properties": {
          "label": { "type": "string" },
          "href": { "type": "string", "format": "uri" },
          "icon": { "type": "string", "enum": ["github","external-link","arrow-right","arrow-down"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
